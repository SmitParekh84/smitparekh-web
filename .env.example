# ---------------------------------------------------------------------------
# Smit-Portfolio new-frontend - environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env*`.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Public (safe to expose to browser) ------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_PYTHON_API_URL=
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server-only (NEVER add NEXT_PUBLIC_ prefix to these) ------------------
# Supabase service role — bypasses RLS. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase CLI tokens (local dev only, not needed in production)
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Tool quota settings
IP_HASH_SALT=change-me-to-a-long-random-string
IP_QUOTA_MULTIPLIER=3

# Upstash Redis (REST) — fast-path cache for tool-usage quota counts.
# Optional: if unset, quotas fall back to Supabase COUNT queries (slower, but works).
# Find both under Upstash console → your database → "REST API". Use the Singapore DB.
UPSTASH_REDIS_REST_URL=https://<db-name>-singapore.upstash.io
UPSTASH_REDIS_REST_TOKEN=<rest-token>

# Admin allowlist — server-only, NOT NEXT_PUBLIC_ (would expose admin identity in DevTools)
ADMIN_EMAILS=you@example.com

# Resend transactional email — server-only
RESEND_API_KEY=re_xxx
RESEND_FROM=Your Name <noreply@yourdomain.com>

# ISR cache revalidation secret — must match REVALIDATE_SECRET in the backend .env.
# If empty, /api/revalidate accepts all callers (fine for local dev, unsafe in prod).
REVALIDATE_SECRET=change-me-to-a-long-random-hex-string

NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
