# ---------------------------------------------------------------------------
# Smit-Portfolio new-frontend - environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env*`.
# ---------------------------------------------------------------------------

# Backend API base URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional: Python tools FastAPI service (Hugging Face Space or local)
NEXT_PUBLIC_PYTHON_API_URL=

# --- Supabase (auth) -------------------------------------------------------
# Find these at: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only — bypasses RLS for quota writes & admin reads. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Tool quotas -----------------------------------------------------------
# Salt for hashing client IPs in tool_usage.ip_hash. Any random string works.
# Rotate to invalidate all guest IP-based counts.
IP_HASH_SALT=change-me-to-a-long-random-string

# How many guest uses count as "1 user" for IP-based quota. Default 3 — allows
# up to 3 distinct browsers behind the same NAT before that IP hits the cap.
IP_QUOTA_MULTIPLIER=3

# --- Admin allowlist -------------------------------------------------------
# Comma-separated emails allowed to access /admin and admin APIs.
# If empty, NO ONE can access admin (locked-down by default).
# The NEXT_PUBLIC_ copy is read by AdminGuard for the client-side gate.
ADMIN_EMAILS=you@example.com
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com
